{
  "feature": {
    "id": "agent-work-tracker",
    "enabled": true,
    "version": "1.0.0",
    "name": {
      "es": "Trabajo de agentes",
      "en": "Agent work"
    },
    "mount": {
      "route": "/agents",
      "navLabel": {
        "es": "Agentes",
        "en": "Agents"
      },
      "icon": "bot"
    },
    "layout3Panel": {
      "left": {
        "component": "AgentFilters",
        "sections": ["status", "owner", "repo", "priority", "search"]
      },
      "center": {
        "component": "AgentTaskBoard",
        "mode": "kanban",
        "columns": ["pending", "in_progress", "blocked", "completed"]
      },
      "right": {
        "component": "AgentDetail",
        "tabs": ["summary", "files", "logs", "timeline"]
      }
    },
    "data": {
      "snapshotEndpoint": "/api/agents/snapshot",
      "historyEndpoint": "/api/agents/history",
      "ws": {
        "enabled": true,
        "url": "ws://localhost:8787/agents",
        "events": [
          "agent.started",
          "agent.updated",
          "agent.blocked",
          "agent.completed",
          "agent.log"
        ],
        "reconnectMs": 2000
      },
      "pollingFallbackMs": 5000
    }
  },
  "seed": {
